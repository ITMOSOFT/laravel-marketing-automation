{
  "name": "itmosoft/laravel-marketing-automation",
  "description": "Event-triggered marketing workflows, execution tracking, and pluggable action handlers for Laravel applications.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/database": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "autoload": {"psr-4": {"ItmoSoft\\MarketingAutomation\\": "src/"}},
  "autoload-dev": {"psr-4": {"ItmoSoft\\MarketingAutomation\\Tests\\": "tests/"}},
  "extra": {"laravel": {"providers": ["ItmoSoft\\MarketingAutomation\\MarketingAutomationServiceProvider"]}},
  "scripts": {"test": "phpunit"},
  "minimum-stability": "stable",
  "prefer-stable": true
}